# Local deterministic E2E only. Submitted production must use APP_ENV=production and PLANNER_MODE=hcx.
APP_ENV=development
PLANNER_MODE=deterministic
MIRAE_DATABASE_PATH=data/serving/mirae_agent.duckdb

# Production HyperCLOVA X. Never commit the real key.
CLOVA_STUDIO_API_KEY=
HCX_MODEL_ID=HCX-007
# Production readiness requires an independently reviewed value that exactly
# matches HCX_MODEL_ID.  HCX-007 above is only the current team default.
APPROVED_HCX_MODEL_ID=
HCX_BASE_URL=https://clovastudio.stream.ntruss.com
HCX_TIMEOUT_SECONDS=12
HCX_TOTAL_DEADLINE_SECONDS=25
HCX_MAX_RETRIES=2
# Conservative single-process defaults. Reconfirm quota after the organizer briefing.
HCX_MAX_CONCURRENCY=3
HCX_QPM_LIMIT=60
DB_MAX_CONCURRENCY=8
# Per-request token-per-minute reservation budget for the planner prompt.
# Two-stage planning (below) cut the real reservation ~13KB->~5.4KB; raise
# this only after checking the provider's actual response-header quota.
HCX_TPM_BUDGET=60000

# federated-completion-v3 semantic layer (see docs/14, docs/15). "two" sends a
# concept-only prompt to HCX and grounds it server-side in grounder.py instead
# of asking HCX for physical field names directly. It is the required default;
# "one" is manual rollback only and there is no automatic fallback.
# VECTOR_ENABLED requires a committed embeddings cache
# (scripts/build_embeddings.py) built from a real CLOVA_STUDIO_API_KEY; with
# no cache, leave this false -- entity resolution still falls back to BM25
# lexical search, just without the vector channel.
PLANNER_STAGE=two
LIVE_HCX_GATE_REPORT=artifacts/live_hcx_gate_report.json
VECTOR_ENABLED=false

# Replace with at least 24 random bytes in production.
CLARIFICATION_SIGNING_KEY=
ENABLE_CLARIFICATION_STATE=true

QUESTION_MAX_CHARS=2000
DEFAULT_RESULT_LIMIT=10
MAX_RESULT_LIMIT=50
