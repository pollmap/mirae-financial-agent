{
	admin off
	auto_https disable_redirects
	skip_install_trust
	servers {
		protocols h1 h2
	}
}

https://{$QA_LAN_BIND_IP}:8443 {
	tls internal

	log {
		output discard
	}

	header {
		Cache-Control "no-store, max-age=0"
		Pragma "no-cache"
		Content-Security-Policy "default-src 'self'; base-uri 'none'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self'"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
		-Server
	}

	request_body {
		max_size 64KB
	}

	route {
		@blocked path /answer /answer/* /demo /demo/* /docs /docs/* /redoc /redoc/* /openapi.json
		respond @blocked 404

		reverse_proxy qa-gateway:8090 {
			# Keep history/export/delete reachable while the engine is degraded.
			health_uri /
			health_interval 30s
			health_timeout 3s
		}
	}
}
