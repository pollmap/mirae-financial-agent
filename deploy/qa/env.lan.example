# Copy to a file outside the repository, replace every placeholder, then use
# `docker compose --env-file <path> -f compose.qa.yaml --profile lan ...`.

APPROVED_HCX_MODEL_ID=replace-with-human-approved-model-id
APPROVED_HCX_BASE_URL=https://clovastudio.stream.ntruss.com
QA_ENGINE_IMAGE=mirae-financial-agent:qa-local
QA_GATEWAY_IMAGE=mirae-human-qa-chatbot:local
ENGINE_GIT_SHA=replace-with-full-40-character-git-sha
ENGINE_IMAGE_DIGEST=replace-with-local-image-sha256
DATA_HASH=replace-with-serving-database-sha256
VECTOR_STATUS=DISABLED_NO_LIVE_CACHE

HCX_API_KEY_FILE=C:/replace/outside/repository/hcx_api.key
ENGINE_CLARIFICATION_SIGNING_KEY_FILE=C:/replace/outside/repository/engine_clarification.key
QA_TRANSCRIPT_KEY_FILE=C:/replace/outside/repository/qa_transcript.key
QA_AUTH_SECRET_FILE=C:/replace/outside/repository/qa_auth.key
QA_RELEASE_GATE_HOST_FILE=C:/replace/outside/repository/qa_release_gate.json

# Must be an address assigned to this host in a private RFC1918 subnet.
QA_LAN_BIND_IP=192.168.1.20
QA_ALLOWED_ORIGINS=https://192.168.1.20:8443
QA_COOKIE_SECURE=true
PILOT_CHAT_ENABLED=false
